  text: 
  ru: "\u0412\u0440\u0430\u0433\u0438, \u0441\u0433\u043E\u0440\u0435\u0432\u0448\u0438\u0435
    \u0434\u043E \u0441\u043C\u0435\u0440\u0442\u0438, \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u044E\u0442
    \u043E\u0433\u043D\u0435\u043D\u043D\u0443\u044E \u0437\u043E\u043D\u0443 \u043D\u0430
